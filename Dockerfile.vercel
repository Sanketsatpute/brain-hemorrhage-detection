FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Upgrade pip separately
RUN pip install --no-cache-dir --upgrade pip

# Install TensorFlow separately
RUN pip install --no-cache-dir tensorflow==2.13.0

# Install application dependencies separately
RUN pip install --no-cache-dir \
    Flask==2.3.3 \
    Flask-CORS==4.0.0 \
    numpy==1.24.3 \
    opencv-python-headless==4.8.0.76 \
    Pillow==10.0.0 \
    Werkzeug==2.3.7 \
    gunicorn==21.2.0

COPY app.py .
COPY model/ ./model/
COPY templates/ ./templates/
COPY static/ ./static/

CMD ["sh", "-c", "gunicorn --bind 0.0.0.0:${PORT:-80} app:app"]